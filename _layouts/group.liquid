---
layout: page
---

<div class="post">
  <article>
    {% if page.profiles and page.sections %}

      {% assign printed_section = false %}

      {% for section in page.sections %}
        {% assign section_type = section.type | strip %}
        {% assign section_title = section.title | default: section_type %}
        {% assign section_profiles = page.profiles | where: "type", section_type %}

        {% assign show_section = false %}
        {% if section_profiles.size > 0 or section.show_empty %}
          {% assign show_section = true %}
        {% endif %}

        {% if show_section %}

          {% if printed_section %}
            <hr class="group-separator">
          {% endif %}
          {% assign printed_section = true %}

          <section class="group-section" id="{{ section_type | slugify }}">
            <h2 class="category">{{ section_title }}</h2>

            {% if section_profiles.size > 0 %}

                {% if section_type == "prof" %}
                  <!-- Faculty: 单栏显示 -->
                  {% for profile in section_profiles %}
                    <div class="group-member faculty-member">

                      {% if profile.image or profile.name %}
                        <div class="profile float-{% if profile.align == 'right' %}right{% else %}left{% endif %}">
                          {% if profile.image %}
                            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}

                            {% if profile.image_circular %}
                              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                            {% else %}
                              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                            {% endif %}

                            {% assign profile_alt = profile.name | default: profile.image %}

                            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}

                            {% include figure.liquid
                              loading="eager"
                              path=profile_image_path
                              class=profile_image_class
                              sizes=sizes
                              alt=profile_alt
                            %}
                          {% endif %}

                          {% if profile.name %}
                            <div class="name">{{ profile.name }}</div>
                          {% endif %}
                        </div>
                      {% endif %}

                      <div class="clearfix">
                        {% include person_content.liquid profile=profile %}
                      </div>

                    </div>
                  {% endfor %}

                {% else %}
                  <!-- 非 Faculty: 左右双栏显示 -->
                  <div class="row row-cols-1 row-cols-md-2 g-4 group-grid">
                    {% for profile in section_profiles %}
                      <div class="col">
                        <div class="group-member group-member-card">

                          <div class="profile-grid-layout">
                            {% if profile.image %}
                              <div class="profile-grid-image">
                                {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}

                                {% if profile.image_circular %}
                                  {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                                {% else %}
                                  {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                                {% endif %}

                                {% capture sizes %}(min-width: {{ site.max_width }}) 160px, (min-width: 576px) 25vw, 95vw{% endcapture %}

                                {% include figure.liquid
                                  loading="lazy"
                                  path=profile_image_path
                                  class=profile_image_class
                                  sizes=sizes
                                  alt=profile_alt
                                %}
                              </div>
                            {% endif %}

                            <div class="profile-grid-content">
                              {% include person_content.liquid profile=profile %}
                            </div>
                          </div>

                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

              {% elsif section.empty_text %}
                <p>{{ section.empty_text }}</p>
              {% endif %}

          </section>
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if content != blank %}
      <hr class="group-separator">

      <div class="group-extra">
        {{ content }}
      </div>
    {% endif %}

  </article>
</div>
